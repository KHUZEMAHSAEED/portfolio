# Copy to .env.local (local dev) and add the same keys in Vercel → Project → Settings → Environment Variables.

# Canonical site URL used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://khuzemah.growthpulse.space

# --- Contact form: SMTP delivery (recommended) ---
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character code as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=khuzemahrezaid@gmail.com
SMTP_PASS=
# Optional — defaults to "Portfolio Contact" <SMTP_USER>
# SMTP_FROM="Portfolio Contact <khuzemasaeed@gmail.com>"

# Where form messages are delivered (defaults to khuzemasaeed@gmail.com)
CONTACT_RECIPIENT_EMAIL=khuzemasaeed@gmail.com

# Optional — shows a "Book a 15-min call" button in the contact dialog
# NEXT_PUBLIC_CAL_LINK=https://cal.com/your-handle/15min
